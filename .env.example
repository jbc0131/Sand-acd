# Server-only. Never exposed to the browser.
ANTHROPIC_API_KEY=
# Diagram extraction, manual enrichment, copilot
CDA_MODEL_MAIN=claude-sonnet-5-5
# Short cleanup and summaries
CDA_MODEL_FAST=claude-haiku-5-5
MAX_UPLOAD_MB=50
# Optional: token prices for the Baseline cost-per-drawing figure (USD per million tokens).
# No defaults: when unset, the Baseline shows token counts only.
CDA_PRICE_IN_PER_MTOK=
CDA_PRICE_OUT_PER_MTOK=
